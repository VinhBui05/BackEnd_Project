@model IEnumerable<BackEnd_Project.Models.Product>

@{
    ViewData["Title"] = "Danh sách Pizza";
}

<h2 class="mb-4">🍕 Danh sách Pizza</h2>

<p>
    <a asp-action="Create" class="btn btn-success">
        + Thêm Pizza Mới
    </a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Chưa có pizza nào trong danh sách.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tên Pizza</th>
                <th>Giá (VNĐ)</th>
                <th>Danh mục</th>
                <th>Mô tả</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Price.ToString("N0") đ</td>
                    <td>@item.Category</td>
                    <td>@item.Description</td>
                    <td>
                        <a asp-controller="Product"
                           asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-primary">
                            Chi tiết
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
